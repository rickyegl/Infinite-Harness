{
  "_comment": "Template. Copy to harness.local.json (gitignored) and fill in real values; it is merged over this file key by key. Code reads config only through apps/bridge/src/config.ts.",
  "bridge": { "port": 7411, "host": "127.0.0.1", "runsDir": "runs", "tokenFile": "runs/.bridge-token" },
  "proxy": {
    "baseUrl": "http://127.0.0.1:8317/v1",
    "apiKeyEnv": "HARNESS_PROXY_KEY",
    "keyFile": "<the proxy's own config file, read by path when the variable is not set>",
    "keyField": "api-keys",
    "routerModel": "<model id for the router>",
    "testModel": "<model id the tests and record:router route with>",
    "imageModel": "<model id for image generation and edits>",
    "signInUrl": "<the proxy's own sign-in page>",
    "timeoutMs": 30000
  },
  "router": { "worker": "secondary", "timeoutMs": 120000 },
  "workers": {
    "primary": { "adapter": "stream-json", "cmd": "<agent cli>", "args": [], "model": "<optional model id>", "timeoutMs": 1800000 },
    "secondary": { "adapter": "exec-jsonl", "cmd": "<agent cli>", "args": [], "model": "<optional model id>", "timeoutMs": 1800000 }
  },
  "defaultWorker": "secondary",
  "mock": { "enabled": false, "speed": 1 },
  "assetKinds": {
    "image": "assets.image",
    "model3d": "assets.model3d",
    "video": "assets.video",
    "voice": "voice",
    "music": "music"
  },
  "paths": {
    "studio": "<video studio project root>",
    "forge": "<colab asset forge project root>",
    "proxy": "<local model proxy folder>",
    "unityEditor": "<Unity.exe of the Unity 6 editor>",
    "unityProject": "runs/.game/unity",
    "robloxProject": "runs/.game/roblox",
    "blender": "<blender executable>",
    "ffmpeg": "ffmpeg",
    "canvasMcp": "<course MCP server folder>",
    "frcSim": "<FRC simulator project>",
    "unityToRoblox": "<Unity-to-Roblox porting project>",
    "imageToVideo": "<colab image-to-video launcher>",
    "forecast": "<forecast script, optional>"
  },
  "colab": { "session": "forge", "gpu": "L4", "keepAlive": false },
  "voice": {
    "envFile": "<path to the .env that holds the voice key and voice id>",
    "account": { "use": "<the line in envFile with the key of the account that pays, optional>", "as": "<the key name the narration tool reads>" },
    "presets": {
      "premise": { "voice": "<voice id of the premise narrator>", "fx": "A", "speed": 1.15, "maxChars": 900 },
      "explainer": { "voice": "<voice id of the explainer narrator>", "model": "<its model id>", "fx": "none", "maxChars": 700 }
    }
  },
  "brandDenyList": ["<vendor and model names that must never appear as text in UI, docs or frames; maker icons are exempt by path, see the contract>"]
}
