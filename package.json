{
  "name": "infinite-harness",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter bridge --filter web dev",
    "bridge": "pnpm --filter bridge dev",
    "site": "pnpm --filter web dev",
    "pair": "pnpm --filter bridge pair",
    "take": "pnpm --filter bridge take",
    "fixture": "pnpm --filter bridge fixture",
    "smoke": "pnpm --filter bridge smoke",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint:brand": "node tools/lint-brand.mjs",
    "shots:direct": "node video/tools/direct.mjs",
    "shots:sheet": "node video/tools/sheet.mjs",
    "film:rough": "node video/tools/rough.mjs",
    "test:live": "node apps/web/test/live.mjs",
    "test:bridge": "pnpm --filter bridge exec tsx ../web/test/bridge.mjs",
    "test:determinism": "node apps/web/test/determinism.mjs"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
