{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "types": [
      "node"
    ],
    "paths": {
      "@harness/protocol": [
        "../../packages/protocol/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "../../modules/*/run.ts"
  ]
}
